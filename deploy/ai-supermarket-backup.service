[Unit]
Description=Back up the AI Supermarket production database

[Service]
Type=oneshot
User=root
UMask=0077
StateDirectory=ai-supermarket-backups
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ExecStart=/usr/bin/python3 /opt/ai-supermarket/current/deploy/backup.py
