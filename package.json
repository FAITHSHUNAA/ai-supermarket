{
  "name": "ai-supermarket",
  "version": "1.0.0",
  "private": true,
  "description": "模块化 AI 超市：应用货架、模型调用、会员积分、开发者中心与管理后台。",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "test": "node server/selfcheck.js"
  },
  "dependencies": {
    "alipay-sdk": "^4.14.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "vite": "^6.4.1"
  }
}
